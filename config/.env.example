# SMP 예측 프로그램 환경변수 템플릿
# 사용법: 본 파일을 config/.env 로 복사 후 실제 값 입력 (config/.env 는 git 커밋 제외)

# ── 전력거래소(KPX) / 공공데이터포털 ─────────────
# 발급: https://www.data.go.kr  (SMP 실적·전력수요 조회용)
KPX_API_KEY=

# ── 기상청 단기예보 API (확장 2단계에서 사용) ────
KMA_API_KEY=

# ── 한국석유공사 오피넷 (확장 2단계에서 사용) ────
OPINET_API_KEY=

# ── 실행 환경 ───────────────────────────────────
# DEV | PROD
APP_ENV=DEV
LOG_LEVEL=INFO

# ── 경로(상대경로 기준: 프로젝트 루트) ───────────
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed
OUTPUT_DIR=outputs
