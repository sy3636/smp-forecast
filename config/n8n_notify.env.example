# n8n 외부 통지 PoC — config/.env 에 아래 키를 추가하거나 본 파일을
# config/n8n_notify.env 로 복사 후 내용을 config/.env 에 병합.
# ※ 시크릿·URL 은 Git에 커밋하지 말 것.

# 모두의 AI 실험실 n8n Webhook URL (Production URL)
N8N_WEBHOOK_URL=

# n8n 워크플로에서 Header X-SMP-Notify-Secret 과 동일 값
N8N_WEBHOOK_SECRET=

# 동일 dedupe_key 재전송 억제(분). 0이면 억제 없음
N8N_NOTIFY_DEDUPE_MIN=60
