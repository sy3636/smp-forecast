# ==============================================================================
# SMP 웨어하우스·Grafana 접속 설정 예시
# ==============================================================================
# 사용법 : 본 파일 내용을 config/.env 에 복사 후 값 입력
#          config/.env 는 이미지에 미포함·읽기전용 마운트(자격증명 분리 원칙)
# ==============================================================================

# ── Postgres(웨어하우스) ─────────────────────────────────────
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=smp
PGUSER=smp
PGPASSWORD=                      # 필수 — 미설정 시 컨테이너 기동 실패
PG_BIND=127.0.0.1                # 외부 노출 금지(기본 로컬 전용)

# 컨테이너 내부에서 적재 실행 시에는 PGHOST=postgres 로 지정

# ── 로컬 Grafana(profile: local) ─────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=               # 필수
GF_BIND=127.0.0.1

# ── Grafana Cloud 연결(profile: cloud) ───────────────────────
# Grafana Cloud 콘솔 > Connections > Private data source connect 에서 발급
PDC_TOKEN=
PDC_CLUSTER=                     # 예: prod-ap-southeast-1
PDC_HG_ID=                       # Hosted Grafana 인스턴스 ID(숫자)
